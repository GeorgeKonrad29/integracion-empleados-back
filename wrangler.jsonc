/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "integracion-empleados-back",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "integracion_empleados_data_base",
          "database_id": "96602da8-f6bb-4cc1-805f-d47f96f09565"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "29806d0257da4c6e996ae6340e9153c2",
            "binding": "SECRET",
            "secret_name": "secret"
        }
    ],
	"observability": {
		"enabled": true
	}
}
